# Build for linux/amd64. Source media are fetched at run time.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-aws.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend ./backend
COPY tools ./tools
COPY server.py ./server.py
COPY integrations/aws/sagemaker_worker.py ./sagemaker_worker.py
ENV RUN_MODE=aws AWS_AI_ENGINE=strands PYTHONUNBUFFERED=1 PREVIOUSLY_AUDIT_STDOUT=1
ENTRYPOINT ["python", "sagemaker_worker.py"]
