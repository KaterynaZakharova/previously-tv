# Build for linux/arm64. No movies, SQLite catalog, keys or viewer state in image.
FROM python:3.12-slim
WORKDIR /app
COPY requirements-aws.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/__init__.py backend/ai.py backend/aws_ai.py ./backend/
COPY integrations/aws/agentcore_app.py ./agentcore_app.py
ENV PYTHONUNBUFFERED=1 PREVIOUSLY_AUDIT_STDOUT=1
EXPOSE 8080
CMD ["python", "agentcore_app.py"]
