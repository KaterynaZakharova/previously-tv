      "episode_start": "00:00:03.500",
      "episode_end": "00:00:04.699",
      "text": "Nothing to worry about.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 25,
      "start": "00:03:46.000",
      "end": "00:03:47.000",
      "episode_start": "00:00:05.000",
      "episode_end": "00:00:06.000",
      "text": "Thom.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 26,
      "start": "00:03:51.000",
      "end": "00:03:53.000",
      "episode_start": "00:00:10.000",
      "episode_end": "00:00:12.000",
      "text": "There she is.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 27,
      "start": "00:03:53.500",
      "end": "00:03:54.500",
      "episode_start": "00:00:12.500",
      "episode_end": "00:00:13.500",
      "text": "Now.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 28,
      "start": "00:03:55.000",
      "end": "00:03:56.000",
      "episode_start": "00:00:14.000",
      "episode_end": "00:00:15.000",
      "text": "You love her.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 29,
      "start": "00:03:57.000",
      "end": "00:03:58.500",
      "episode_start": "00:00:16.000",
      "episode_end": "00:00:17.500",
      "text": "She is your passion!",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 30,
      "start": "00:04:00.000",
      "end": "00:04:01.000",
      "episode_start": "00:00:19.000",
      "episode_end": "00:00:20.000",
      "text": "Be tender to her.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 31,
      "start": "00:04:01.500",
      "end": "00:04:04.500",
      "episode_start": "00:00:20.500",
      "episode_end": "00:00:23.500",
      "text": "Be honest! Eh- be tender.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 32,
      "start": "00:04:05.000",
      "end": "00:04:08.000",
      "episode_start": "00:00:24.000",
      "episode_end": "00:00:27.000",
      "text": "Remind her what love is.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 33,
      "start": "00:04:52.000",
      "end": "00:04:55.000",
      "episode_start": "00:01:11.000",
      "episode_end": "00:01:14.000",
      "text": "...and, action!",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 34,
      "start": "00:04:56.500",
      "end": "00:04:58.000",
      "episode_start": "00:01:15.500",
      "episode_end": "00:01:17.000",
      "text": "Memory overwrite in progress!",
      "character_id": 7,
      "speaker": "Techhead",
      "speaker_confidence": "high"
    },
    {
      "id": 35,
      "start": "00:04:59.000",
      "end": "00:05:01.000",
      "episode_start": "00:01:18.000",
      "episode_end": "00:01:20.000",
      "text": "You're a jerk, Thom!",
      "character_id": 5,
      "speaker": "Celia",
      "speaker_confidence": "high"
    },
    {
      "id": 36,
      "start": "00:05:02.500",
      "end": "00:05:05.000",
      "episode_start": "00:01:21.500",
      "episode_end": "00:01:24.000",
      "text": "Ohp- Sorry! Sorry.",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 37,
      "start": "00:05:16.000",
      "end": "00:05:17.000",
      "episode_start": "00:01:35.000",
      "episode_end": "00:01:36.000",
      "text": "Look Celia.",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 38,
      "start": "00:05:18.000",
      "end": "00:05:20.000",
      "episode_start": "00:01:37.000",
      "episode_end": "00:01:39.000",
      "text": "We have to follow our passions.",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 39,
      "start": "00:05:21.000",
      "end": "00:05:23.000",
      "episode_start": "00:01:40.000",
      "episode_end": "00:01:42.000",
      "text": "You have your robotics...",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 40,
      "start": "00:05:25.000",
      "end": "00:05:28.000",
      "episode_start": "00:01:44.000",
      "episode_end": "00:01:47.000",
      "text": "...and I just want to be awesome in space.",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 41,
      "start": "00:05:39.000",
      "end": "00:05:41.000",
      "episode_start": "00:01:58.000",
      "episode_end": "00:02:00.000",
      "text": "Okay, they're coming. Two minutes left!",
      "character_id": 2,
      "speaker": "Barley",
      "speaker_confidence": "inferred"
    },
    {
      "id": 42,
      "start": "00:05:43.000",
      "end": "00:05:44.000",
      "episode_start": "00:02:02.000",
      "episode_end": "00:02:03.000",
      "text": "Speed it up, Thom!",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 43,
      "start": "00:05:45.000",
      "end": "00:05:46.000",
      "episode_start": "00:02:04.000",
      "episode_end": "00:02:05.000",
      "text": "Vivacissimo!",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 44,
      "start": "00:05:47.000",
      "end": "00:05:50.000",
      "episode_start": "00:02:06.000",
      "episode_end": "00:02:09.000",
      "text": "Why don't you just admit that you're freaked out by my robot hand?",
      "character_id": 5,
      "speaker": "Celia",
      "speaker_confidence": "high"
    },
    {
      "id": 45,
      "start": "00:05:56.000",
      "end": "00:05:59.000",
      "episode_start": "00:02:15.000",
      "episode_end": "00:02:18.000",
      "text": "Listen Celia, I was young...",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 46,
      "start": "00:05:59.500",
      "end": "00:06:01.000",
      "episode_start": "00:02:18.500",
      "episode_end": "00:02:20.000",
      "text": "...and a dick.",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 47,
      "start": "00:06:01.000",
      "end": "00:06:03.000",
      "episode_start": "00:02:20.000",
      "episode_end": "00:02:22.000",
      "text": "But that's no reason to destroy the world.",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 48,
      "start": "00:06:05.000",
      "end": "00:06:06.000",
      "episode_start": "00:02:24.000",
      "episode_end": "00:02:25.000",
      "text": "Why does he do this?",
      "character_id": 7,
      "speaker": "Techhead",
      "speaker_confidence": "high"
    },
    {
      "id": 49,
      "start": "00:06:06.500",
      "end": "00:06:08.500",
      "episode_start": "00:02:25.500",
      "episode_end": "00:02:27.500",
      "text": "We already tried that one!",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 50,
      "start": "00:06:11.500",
      "end": "00:06:12.500",
      "episode_start": "00:02:30.500",
      "episode_end": "00:02:31.500",
      "text": "Abort!",
      "character_id": 7,
      "speaker": "Techhead",
      "speaker_confidence": "high"
    },
    {
      "id": 51,
      "start": "00:06:13.000",
      "end": "00:06:14.000",
      "episode_start": "00:02:32.000",
      "episode_end": "00:02:33.000",
      "text": "Cut!",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 52,
      "start": "00:06:14.000",
      "end": "00:06:15.000",
      "episode_start": "00:02:33.000",
      "episode_end": "00:02:34.000",
      "text": "Whoaaa!",
      "character_id": null,
      "speaker": null,
      "speaker_confidence": "unidentified"
    },
    {
      "id": 53,
      "start": "00:06:19.000",
      "end": "00:06:20.000",
      "episode_start": "00:02:38.000",
      "episode_end": "00:02:39.000",
      "text": "Whoaaa!",
      "character_id": null,
      "speaker": null,
      "speaker_confidence": "unidentified"
    },
    {
      "id": 54,
      "start": "00:06:21.000",
      "end": "00:06:23.000",
      "episode_start": "00:02:40.000",
      "episode_end": "00:02:42.000",
      "text": "Nooooo!",
      "character_id": null,
      "speaker": null,
      "speaker_confidence": "unidentified"
    },
    {
      "id": 55,
      "start": "00:06:23.000",
      "end": "00:06:25.000",
      "episode_start": "00:02:42.000",
      "episode_end": "00:02:44.000",
      "text": "You broke my heart.",
      "character_id": 5,
      "speaker": "Celia",
      "speaker_confidence": "high"
    },
    {
      "id": 56,
      "start": "00:06:26.000",
      "end": "00:06:27.000",
      "episode_start": "00:02:45.000",
      "episode_end": "00:02:46.000",
      "text": "I know.",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 57,
      "start": "00:06:27.000",
      "end": "00:06:29.000",
      "episode_start": "00:02:46.000",
      "episode_end": "00:02:48.000",
      "text": "You forgot me on earth.",
      "character_id": 5,
      "speaker": "Celia",
      "speaker_confidence": "high"
    },
    {
      "id": 58,
      "start": "00:06:29.000",
      "end": "00:06:30.000",
      "episode_start": "00:02:48.000",
      "episode_end": "00:02:49.000",
      "text": "I know.",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 59,
      "start": "00:06:30.500",
      "end": "00:06:33.000",
      "episode_start": "00:02:49.500",
      "episode_end": "00:02:52.000",
      "text": "I should just crush you.",
      "character_id": 5,
      "speaker": "Celia",
      "speaker_confidence": "high"
    },
    {
      "id": 60,
      "start": "00:06:36.000",
      "end": "00:06:37.000",
      "episode_start": "00:02:55.000",
      "episode_end": "00:02:56.000",
      "text": "I'm-",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 61,
      "start": "00:06:47.000",
      "end": "00:06:48.000",
      "episode_start": "00:03:06.000",
      "episode_end": "00:03:07.000",
      "text": "I'm sorry.",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 62,
      "start": "00:06:50.000",
      "end": "00:06:51.000",
      "episode_start": "00:03:09.000",
      "episode_end": "00:03:10.000",
      "text": "Good ad-lib.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "inferred"
    },
    {
      "id": 63,
      "start": "00:06:59.000",
      "end": "00:07:00.500",
      "episode_start": "00:03:18.000",
      "episode_end": "00:03:19.500",
      "text": "Not my fault!",
      "character_id": 7,
      "speaker": "Techhead",
      "speaker_confidence": "high"
    },
    {
      "id": 64,
      "start": "00:07:02.000",
      "end": "00:07:03.000",
      "episode_start": "00:03:21.000",
      "episode_end": "00:03:22.000",
      "text": "This time.",
      "character_id": 7,
      "speaker": "Techhead",
      "speaker_confidence": "high"
    },
    {
      "id": 65,
      "start": "00:07:08.000",
      "end": "00:07:09.500",
      "episode_start": "00:03:27.000",
      "episode_end": "00:03:28.500",
      "text": "Quiet on set!",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "inferred"
    },
    {
      "id": 66,
      "start": "00:07:10.000",
      "end": "00:07:11.000",
      "episode_start": "00:03:29.000",
      "episode_end": "00:03:30.000",
