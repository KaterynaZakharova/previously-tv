  "lines": [
    {
      "id": 1,
      "start": "00:00:23.000",
      "end": "00:00:24.500",
      "episode_start": "00:00:23.000",
      "episode_end": "00:00:24.500",
      "text": "You're a jerk, Thom.",
      "character_id": 5,
      "speaker": "Celia",
      "speaker_confidence": "high"
    },
    {
      "id": 2,
      "start": "00:00:25.000",
      "end": "00:00:27.000",
      "episode_start": "00:00:25.000",
      "episode_end": "00:00:27.000",
      "text": "Look Celia, we have to follow our passions;",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 3,
      "start": "00:00:27.000",
      "end": "00:00:30.500",
      "episode_start": "00:00:27.000",
      "episode_end": "00:00:30.500",
      "text": "...you have your robotics, and I just want to be awesome in space.",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 4,
      "start": "00:00:30.800",
      "end": "00:00:34.000",
      "episode_start": "00:00:30.800",
      "episode_end": "00:00:34.000",
      "text": "Why don't you just admit that you're freaked out by my robot hand?",
      "character_id": 5,
      "speaker": "Celia",
      "speaker_confidence": "high"
    },
    {
      "id": 5,
      "start": "00:00:34.500",
      "end": "00:00:36.000",
      "episode_start": "00:00:34.500",
      "episode_end": "00:00:36.000",
      "text": "I'm not freaked out by- it's...",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 6,
      "start": "00:00:37.000",
      "end": "00:00:38.000",
      "episode_start": "00:00:37.000",
      "episode_end": "00:00:38.000",
      "text": "...alright! Fine!",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 7,
      "start": "00:00:38.000",
      "end": "00:00:41.000",
      "episode_start": "00:00:38.000",
      "episode_end": "00:00:41.000",
      "text": "I'm freaked out! I have nightmares that I'm being chased...",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 8,
      "start": "00:00:41.000",
      "end": "00:00:42.000",
      "episode_start": "00:00:41.000",
      "episode_end": "00:00:42.000",
      "text": "...by these giant robotic claws of death...",
      "character_id": 4,
      "speaker": "Thom (young)",
      "speaker_confidence": "high"
    },
    {
      "id": 9,
      "start": "00:00:43.000",
      "end": "00:00:45.000",
      "episode_start": "00:00:43.000",
      "episode_end": "00:00:45.000",
      "text": "Whatever, Thom. We're done.",
      "character_id": 5,
      "speaker": "Celia",
      "speaker_confidence": "high"
    },
    {
      "id": 10,
      "start": "00:00:50.000",
      "end": "00:00:53.500",
      "episode_start": "00:00:50.000",
      "episode_end": "00:00:53.500",
      "text": "Robot's memory synced and locked!",
      "character_id": 7,
      "speaker": "Techhead",
      "speaker_confidence": "high"
    },
    {
      "id": 11,
      "start": "00:01:01.000",
      "end": "00:01:03.000",
      "episode_start": "00:01:01.000",
      "episode_end": "00:01:03.000",
      "text": "This is pretty freaky.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 12,
      "start": "00:01:57.000",
      "end": "00:01:59.000",
      "episode_start": "00:01:57.000",
      "episode_end": "00:01:59.000",
      "text": "Shouldn't you be down there?",
      "character_id": 2,
      "speaker": "Barley",
      "speaker_confidence": "inferred"
    },
    {
      "id": 13,
      "start": "00:02:11.000",
      "end": "00:02:13.000",
      "episode_start": "00:02:11.000",
      "episode_end": "00:02:13.000",
      "text": "I heard you guys talking last night.",
      "character_id": 1,
      "speaker": "Thom (older)",
      "speaker_confidence": "high"
    },
    {
      "id": 14,
      "start": "00:02:16.000",
      "end": "00:02:18.000",
      "episode_start": "00:02:16.000",
      "episode_end": "00:02:18.000",
      "text": "It's not my fault, you know.",
      "character_id": 1,
      "speaker": "Thom (older)",
      "speaker_confidence": "high"
    },
    {
      "id": 15,
      "start": "00:03:11.000",
      "end": "00:03:12.000",
      "episode_start": "00:03:11.000",
      "episode_end": "00:03:12.000",
      "text": "Are you ready?",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 16,
      "start": "00:03:13.000",
      "end": "00:03:15.000",
      "episode_start": "00:03:13.000",
      "episode_end": "00:03:15.000",
      "text": "Of course you're ready, you're a rockstar.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 17,
      "start": "00:03:17.000",
      "end": "00:03:18.000",
      "episode_start": "00:03:17.000",
      "episode_end": "00:03:18.000",
      "text": "How's it looking, Barley?",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 18,
      "start": "00:03:19.000",
      "end": "00:03:21.000",
      "episode_start": "00:03:19.000",
      "episode_end": "00:03:21.000",
      "text": "We should have about ten minutes...",
      "character_id": 2,
      "speaker": "Barley",
      "speaker_confidence": "inferred"
    },
    {
      "id": 19,
      "start": "00:03:21.500",
      "end": "00:03:23.000",
      "episode_start": "00:03:21.500",
      "episode_end": "00:03:23.000",
      "text": "Well that's perfect.",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 20,
      "start": "00:03:23.500",
      "end": "00:03:26.500",
      "episode_start": "00:03:23.500",
      "episode_end": "00:03:26.500",
      "text": "We're on in one! All systems go! Yeah you, go!",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 21,
      "start": "00:03:28.000",
      "end": "00:03:32.000",
      "episode_start": "00:03:28.000",
      "episode_end": "00:03:32.000",
      "text": "Go! Move your asses! Go go go!",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    },
    {
      "id": 22,
      "start": "00:03:33.000",
      "end": "00:03:37.000",
      "episode_start": "00:03:33.000",
      "episode_end": "00:03:37.000",
      "text": "I love it! Come on, go!",
      "character_id": 3,
      "speaker": "Captain",
      "speaker_confidence": "high"
    }
  ]
}
